class JinOscillator:
    """Exact Jin (1997) recharge oscillator."""
    def __init__(self, params: Optional[OmegaParameters] = None, seed: int = 42):
        p = params or OmegaParameters()
        self.alpha_T = p.alpha0
        self.alpha2  = p.alpha2
        self.c       = p.c
        self.d       = p.d
        self.A_force = p.A_force
        self.T_force = p.T_force
        self.eta_std = p.eta_std
        self.noise_type = p.noise_type
        self.student_df = p.student_df
        self.mult_strength = p.mult_strength
        self.rng = default_rng(seed)
        self.state = np.array([0.0, 0.0])
        self.time = 0.0

    def _noise(self, dt: float, φ: float) -> float:
        sqrt_dt = np.sqrt(dt)
        if self.noise_type == "gaussian":
            return sqrt_dt * self.eta_std * self.rng.normal()
        elif self.noise_type == "multiplicative":
            scale = 1.0 + self.mult_strength * abs(φ)
            return sqrt_dt * self.eta_std * scale * self.rng.normal()
        elif self.noise_type == "student_t":
            return sqrt_dt * self.eta_std * self.rng.standard_t(self.student_df)
        return 0.0

    def rhs(self, state: np.ndarray, t: float = 0.0) -> np.ndarray:
        φ, z = state
        forcing = self.A_force * np.sin(2*np.pi*t / self.T_force)
        return np.array([-self.alpha_T*φ + self.alpha2*z + forcing,
                         -self.c*φ - self.d*z])

    def step_rk4(self, dt: float, stochastic: bool = True) -> None:
        t = self.time
        s = self.state.copy()
        k1 = self.rhs(s, t)
        k2 = self.rhs(s + 0.5*dt*k1, t + 0.5*dt)
        k3 = self.rhs(s + 0.5*dt*k2, t + 0.5*dt)
        k4 = self.rhs(s + dt*k3, t + dt)
        self.state = s + (dt/6.0)*(k1 + 2*k2 + 2*k3 + k4)
        if stochastic:
            nφ = self._noise(dt, self.state[0])
            self.state[0] += nφ
        self.time += dt

    def integrate(self, n_steps=2000, dt=0.1, stochastic=True, init=None) -> np.ndarray:
        if init is not None:
            self.state = np.asarray(init, dtype=float).copy()
        else:
            self.state = np.array([0.5, -3.0])
        traj = np.zeros((n_steps+1, 2))
        traj[0] = self.state.copy()
        self.time = 0.0
        for i in range(n_steps):
            self.step_rk4(dt, stochastic=stochastic)
            traj[i+1] = self.state.copy()
        return traj

