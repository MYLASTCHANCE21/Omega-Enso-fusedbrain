def residence_times(phi: np.ndarray, threshold: float = BISTABILITY_THRESHOLD) -> np.ndarray:
    above = phi > threshold
    switches = np.where(np.diff(above.astype(int)))[0]
    if len(switches) < 2:
        return np.array([])
    return np.diff(switches)

def coherence_metrics(phi: np.ndarray, dt: float, threshold: float = BISTABILITY_THRESHOLD) -> Dict:
    rt = residence_times(phi, threshold)
    if len(rt) < 2:
        return {"mean_rt": np.nan, "cv_rt": np.nan, "n_switches": 0}
    mean_rt = float(np.mean(rt) * dt)
    cv_rt = float(np.std(rt) / (np.mean(rt) + 1e-12))
    return {"mean_rt": mean_rt, "cv_rt": cv_rt, "n_switches": len(rt)}

def snr_proxy(phi: np.ndarray, dt: float, T_force: float = 48.0) -> float:
    freqs = rfftfreq(len(phi), d=dt)
    psd = np.abs(rfft(phi - np.mean(phi)))**2
    f_target = 1.0 / T_force
    band = (freqs > f_target*0.8) & (freqs < f_target*1.2)
    if not np.any(band):
        return 0.0
    return float(np.mean(psd[band]) / (np.mean(psd[~band]) + 1e-12))

def compute_framework_energy_stability(trajectory_matrix: np.ndarray, params: OmegaParameters, return_raw: bool = False) -> dict:
    phi_states = trajectory_matrix[:, 0]
    z_states = trajectory_matrix[:, 1]
    beta_safe = params.beta if params.beta != 0.0 else 1.0
    potential_energy = 0.25 * (phi_states**4) - 0.5 * (phi_states**2)
    kinetic_energy = 0.5 * (z_states**2) / beta_safe
    total_energy = potential_energy + kinetic_energy
    metrics = {"mean_energy": float(np.mean(total_energy)), "std_energy": float(np.std(total_energy))}
    if return_raw:
        metrics["raw_energy_array"] = total_energy
    return metrics

def compute_entropy_generation(trajectory_matrix: np.ndarray, params: OmegaParameters, dt: float) -> np.ndarray:
    if dt <= 0:
        raise ValueError(f"dt must be positive, got {dt}")
    phi_states = trajectory_matrix[:, 0]
    z_states = trajectory_matrix[:, 1]
    p_states = trajectory_matrix[:, 2]
    damping_dissipation_p = params.lam * p_states**2
    damping_dissipation_z = params.d * z_states**2
    noise_power = params.eta_std**2 + params.xi_std**2 + params.theta_std**2
    entropy_gen_rate = (damping_dissipation_p + damping_dissipation_z + noise_power) / dt
    return entropy_gen_rate

def compute_framework_thermodynamics(trajectory_matrix: np.ndarray, params: OmegaParameters, dt: float) -> dict:
    phi = trajectory_matrix[:, 0]
    z = trajectory_matrix[:, 1]
    beta_safe = params.beta if params.beta != 0.0 else 1.0
    potential_energy = 0.25 * (phi**4) - 0.5 * (phi**2)
    kinetic_energy = 0.5 * (z**2) / beta_safe
    total_energy = potential_energy + kinetic_energy
    dphi = np.diff(phi) / dt
    lam_safe = params.lam if params.lam != 0.0 else 1.0
    entropy_gen = (dphi**2) * lam_safe
    phi_clipped = phi[:-1]
    pos_mask = phi_clipped > 0.0
    neg_mask = phi_clipped < 0.0
    return {
        "mean_energy": float(np.mean(total_energy)),
        "std_energy": float(np.std(total_energy)),
        "entropy_pos_mean": float(np.mean(entropy_gen[pos_mask])) if np.any(pos_mask) else 0.0,
        "entropy_pos_std": float(np.std(entropy_gen[pos_mask])) if np.any(pos_mask) else 0.0,
        "entropy_neg_mean": float(np.mean(entropy_gen[neg_mask])) if np.any(neg_mask) else 0.0,
        "entropy_neg_std": float(np.std(entropy_gen[neg_mask])) if np.any(neg_mask) else 0.0
    }

