# 5. PHASE-LOCKING (ARNOLD TONGUE)
# =====================================================================
def analyze_arnold_tongue_locking(trajectory_matrix: np.ndarray, forcing_phase_array: np.ndarray) -> Dict:
    phi_states = trajectory_matrix[:, 0]
    z_derived = np.diff(phi_states, append=phi_states[-1])
    system_phase = np.arctan2(z_derived, phi_states)
    phase_diff = np.mod(system_phase - forcing_phase_array + np.pi, 2 * np.pi) - np.pi
    sin_mean = np.mean(np.sin(phase_diff))
    cos_mean = np.mean(np.cos(phase_diff))
    mean_phase_deg = np.degrees(np.arctan2(sin_mean, cos_mean))
    R_vector_length = np.sqrt(sin_mean**2 + cos_mean**2)
    circ_std_deg = np.degrees(np.sqrt(-2 * np.log(R_vector_length))) if R_vector_length > 1e-6 else 180.0
    return {
        "mean_phase_difference_deg": float(mean_phase_deg),
        "synchronization_coherence_R": float(R_vector_length),
        "circular_std_dev_deg": float(circ_std_deg),
        "is_locked": bool(R_vector_length > 0.85 and circ_std_deg < 30.0),
    }

def perform_phase_locking_sweep(initial_params: OmegaParameters, sigma_fixed: float, lam_fixed: float,
                                a_force_range: np.ndarray, t_force_range: np.ndarray,
                                n_steps_sim: int = 50000, dt_sim: float = 0.1,
                                transient_sim: int = 2000, seed_sim: int = 42) -> Dict:
    r_coherence_matrix = np.zeros((len(a_force_range), len(t_force_range)))
    circ_std_dev_matrix = np.zeros((len(a_force_range), len(t_force_range)))
    is_locked_matrix = np.full((len(a_force_range), len(t_force_range)), False, dtype=bool)
    print("\n--- Performing Phase-Locking Parameter Sweep ---")
    for i, current_a_force in enumerate(a_force_range):
        print(f"  Sweeping A_force = {current_a_force:.4f}...")
        for j, current_t_force in enumerate(t_force_range):
            current_params = replace(initial_params, sigma=sigma_fixed, lam=lam_fixed,
                                     A_force=current_a_force, T_force=current_t_force)
            model = OmegaBoxModel(params=current_params, seed=seed_sim)
            traj = model.integrate(n_steps=n_steps_sim, dt=dt_sim, stochastic=True)
            raw_phi = traj[transient_sim:, 0]
            if HAS_SCIPY:
                nyq = 0.5 * (1.0 / dt_sim)
                cutoff_freq = 0.15
                b, a = butter(N=4, Wn=cutoff_freq / nyq, btype='low')
                filtered_phi = filtfilt(b, a, raw_phi)
            else:
                filtered_phi = np.convolve(raw_phi, np.ones(5)/5, mode='same')
            time_axis_filtered = np.arange(len(filtered_phi)) * dt_sim
            forcing_phase = (2 * np.pi * time_axis_filtered / current_t_force) % (2 * np.pi)
            dummy_steady_state_traj = np.column_stack((filtered_phi, np.zeros_like(filtered_phi)))
            arnold_results = analyze_arnold_tongue_locking(dummy_steady_state_traj, forcing_phase)
            r_coherence_matrix[i, j] = arnold_results["synchronization_coherence_R"]
            circ_std_dev_matrix[i, j] = arnold_results["circular_std_dev_deg"]
            is_locked_matrix[i, j] = arnold_results["is_locked"]
    return {
        "r_coherence_matrix": r_coherence_matrix,
        "circ_std_dev_matrix": circ_std_dev_matrix,
        "is_locked_matrix": is_locked_matrix,
        "a_force_range": a_force_range,
        "t_force_range": t_force_range
    }

def execute_extended_locking_sweep(initial_params: OmegaParameters,
                                   min_amplitude: float = 0.10,
                                   max_amplitude: float = 0.60) -> Optional[float]:
    print("\n--- Initiating Escalated Phase-Locking Parameter Sweep ---")
    escalated_amplitudes = np.linspace(min_amplitude, max_amplitude, 11)
    if initial_params.T_force > 0:
        omega_forcing_val = 2 * np.pi / initial_params.T_force
    else:
        omega_forcing_val = 2 * np.pi / 48.0
    for a_val in escalated_amplitudes:
        print(f"  Sweeping A_force = {a_val:.4f}...")
        p_sweep = replace(initial_params, A_force=a_val)
        model_sweep = OmegaBoxModel(params=p_sweep, seed=42)
        traj_sweep = model_sweep.integrate(n_steps=4000, dt=0.1, stochastic=True)
        time_axis = np.arange(len(traj_sweep)) * 0.1
        forcing_phase = np.mod(omega_forcing_val * time_axis, 2 * np.pi)
        locking_results = analyze_arnold_tongue_locking(traj_sweep, forcing_phase)
        if locking_results["is_locked"]:
            print(f"  [➔ LOCK DETECTED] at A_force = {a_val:.2f}!")
            print(f"    R = {locking_results['synchronization_coherence_R']:.4f}")
            return a_val
    print("No locking detected within the swept range.")
    return None

