def demo_adaptive_threshold_dynamics():
    import matplotlib.pyplot as plt

    p = OmegaParameters(
        sigma=0.78, lam=0.38, A_force=0.03, T_force=48.0,
        eta_std=0.05, xi_std=0.02, theta_std=0.01,
        kappa=0.05, nu=0.02, beta_g=0.01, gamma=0.05,
        gamma_J=0.05, mu_J=0.02
    )
    model = OmegaBoxModel(params=p, seed=42)
    model.set_state(np.array([0.5, -3.0, 0.0, 0.0, 0.0, 0.0]))

    n_steps, dt = 3000, 0.1
    traj = model.integrate(n_steps=n_steps, dt=dt, stochastic=True)
    wind = model.get_wind_series()

    sigma_crits, lambda_crits, alpha_T_effs, d_sigmas, d_lambdas = [], [], [], [], []
    for i in range(len(traj)):
        dist = bifurcation_distance(traj[i], p)
        sigma_crits.append(dist["sigma_crit"])
        lambda_crits.append(dist["lambda_crit"])
        alpha_T_effs.append(dist["alpha_T_eff"])
        d_sigmas.append(dist["d_sigma"])
        d_lambdas.append(dist["d_lambda"])

    sigma_crits = np.array(sigma_crits)
    lambda_crits = np.array(lambda_crits)
    alpha_T_effs = np.array(alpha_T_effs)
    d_sigmas = np.array(d_sigmas)
    d_lambdas = np.array(d_lambdas)
    t = np.arange(len(traj)) * dt

    fig, axes = plt.subplots(4, 1, figsize=(11, 13), sharex=True, gridspec_kw={"hspace": 0.08})

    ax = axes[0]
    ax.plot(t, traj[:, 0], color="#00d4ff", lw=1.2, label=r"$\phi$ (SST anomaly)")
    ax.axhline(0.4, color="crimson", ls="--", lw=1, alpha=0.6, label="Bistability threshold")
    ax.axhline(-0.4, color="crimson", ls="--", lw=1, alpha=0.6)
    ax.set_ylabel(r"$\phi$  [°C]")
    ax.set_title("Ω‑Box Trajectory with Adaptive Bifurcation Surface")
    ax.legend(loc="upper right", fontsize=9)
    ax.grid(True, alpha=0.25)

    ax = axes[1]
    ax.plot(t, alpha_T_effs, color="#2ecc71", lw=1.2, label=r"$\alpha_T^{\mathrm{eff}}$")
    ax.axhline(p.alpha0, color="gray", ls="--", lw=1, alpha=0.6, label=r"$\alpha_0$ (neutral)")
    ax.set_ylabel(r"$\alpha_T^{\mathrm{eff}}$")
    ax.legend(loc="upper right", fontsize=9)
    ax.grid(True, alpha=0.25)

    ax = axes[2]
    ax.plot(t, sigma_crits, color="#e74c3c", lw=1.5, label=r"Dynamic $\sigma_{\mathrm{crit}}(t)$")
    ax.axhline(p.sigma, color="#3498db", ls="--", lw=1.5, alpha=0.8, label=r"Actual $\sigma$ = 0.78")
    ax.fill_between(t, sigma_crits, p.sigma, where=(p.sigma > sigma_crits),
                    color="#e74c3c", alpha=0.15, interpolate=True, label="Linearly unstable region")
    ax.set_ylabel(r"$\sigma$")
    ax.legend(loc="upper right", fontsize=9)
    ax.grid(True, alpha=0.25)

    ax = axes[3]
    ax.plot(t, d_sigmas, color="#9b59b6", lw=1.2, label=r"$d_\sigma = \sigma - \sigma_{\mathrm{crit}}$")
    ax.plot(t, d_lambdas, color="#f39c12", lw=1.2, label=r"$d_\lambda = \lambda - \lambda_{\mathrm{crit}}$")
    ax.axhline(0, color="white", ls="-", lw=0.8, alpha=0.5)
    ax.fill_between(t, 0, d_sigmas, where=(d_sigmas > 0), color="#e74c3c", alpha=0.2, interpolate=True)
    ax.set_ylabel("Signed distance")
    ax.set_xlabel("Time  [model units]")
    ax.legend(loc="upper right", fontsize=9)
    ax.grid(True, alpha=0.25)

    plt.tight_layout()
    out_path = "adaptive_bifurcation_demo.png"
    plt.savefig(out_path, dpi=180, bbox_inches="tight", facecolor="white")
    plt.show()
    print(f"\n[Saved] {out_path}")

    frac_unstable = np.mean((d_sigmas > 0) & (d_lambdas > 0)) * 100
    print(f"\n[Summary] Linearly unstable {frac_unstable:.1f}% of the time,")
    print(f"          yet the nonlinear cycle remains bounded.")
    print(f"          Max σ_crit shift: {np.max(sigma_crits)-np.min(sigma_crits):.4f}")
    print(f"          Max λ_crit shift: {np.max(lambda_crits)-np.min(lambda_crits):.4f}")
    return {"traj": traj, "wind": wind, "sigma_crit_series": sigma_crits,
            "lambda_crit_series": lambda_crits, "alpha_T_eff_series": alpha_T_effs}

