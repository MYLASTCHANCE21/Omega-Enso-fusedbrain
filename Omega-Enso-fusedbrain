# 2. Ω‑BOX MODEL
# =====================================================================
class OmegaBoxModel:
    def __init__(self, params: Optional[OmegaParameters] = None, seed: int = 42):
        self.p = params or OmegaParameters()
        self.rng: Generator = default_rng(seed)
        self.state = np.zeros(6)
        self.time = 0.0
        self.energy_history: List[float] = []
        self._wind_history: List[float] = []

    def _g(self, ψ: float) -> float:
        ψ = np.clip(ψ, PSI_CLIP_BOUNDS[0], PSI_CLIP_BOUNDS[1])
        return float(np.exp(ψ))

    def _noise_increment(self, dt: float, φ: float) -> Tuple[float, float, float]:
        sqrt_dt = np.sqrt(dt)
        par = self.p
        if par.noise_type == "gaussian":
            nφ = sqrt_dt * par.eta_std * self.rng.normal()
            np_ = sqrt_dt * par.xi_std * self.rng.normal()
            nθ = sqrt_dt * par.theta_std * self.rng.normal()
        elif par.noise_type == "multiplicative":
            scale = 1.0 + par.mult_strength * abs(φ)
            nφ = sqrt_dt * par.eta_std * scale * self.rng.normal()
            np_ = sqrt_dt * par.xi_std * scale * self.rng.normal()
            nθ = sqrt_dt * par.theta_std * scale * self.rng.normal()
        elif par.noise_type == "student_t":
            nφ = sqrt_dt * par.eta_std * self.rng.standard_t(par.student_df)
            np_ = sqrt_dt * par.xi_std * self.rng.standard_t(par.student_df)
            nθ = sqrt_dt * par.theta_std * self.rng.standard_t(par.student_df)
        else:
            raise ValueError(f"Unknown noise_type: {par.noise_type}")
        return nφ, np_, nθ

    def rhs(self, state: np.ndarray, t: float = 0.0) -> np.ndarray:
        φ = np.clip(state[0], -5.0, 5.0)
        z = np.clip(state[1], -5.0, 5.0)
        p = np.clip(state[2], -5.0, 5.0)
        ψ = np.clip(state[3], PSI_CLIP_BOUNDS[0], PSI_CLIP_BOUNDS[1])
        J = np.clip(state[4], -5.0, 5.0)
        θ = np.clip(state[5], -5.0, 5.0)
        par = self.p
        g = self._g(ψ)
        alpha_T = par.alpha0 + par.kappa * (g + 1.0/g) + par.nu * J
        forcing = par.A_force * np.sin(2 * np.pi * t / par.T_force)
        dφ = (-alpha_T*φ - par.beta*φ**3 + par.alpha1*p + par.alpha2*z + par.chi*J*φ + forcing)
        dz = -par.c*φ - par.d*z
        dp = -par.lam*p + par.sigma*φ
        dg = par.beta_g*(1.0 - g) + par.gamma*φ
        dψ = dg / max(g, 1e-12)
        dJ = -par.gamma_J*J + par.mu_J*φ**2
        dθ = -par.a*θ - par.b*θ**3 + par.eps*φ
        return np.array([dφ, dz, dp, dψ, dJ, dθ])

    def step_rk4(self, dt: float, stochastic: bool = True) -> None:
        t = self.time
        s = self.state.copy()
        k1 = self.rhs(s, t)
        k2 = self.rhs(s + 0.5*dt*k1, t + 0.5*dt)
        k3 = self.rhs(s + 0.5*dt*k2, t + 0.5*dt)
        k4 = self.rhs(s + dt*k3, t + dt)
        self.state = s + (dt/6.0)*(k1 + 2*k2 + 2*k3 + k4)
        self.state[0] = np.clip(self.state[0], STATE_CLIP_BOUNDS[0], STATE_CLIP_BOUNDS[1])
        self.state[1] = np.clip(self.state[1], STATE_CLIP_BOUNDS[0], STATE_CLIP_BOUNDS[1])
        self.state[2] = np.clip(self.state[2], STATE_CLIP_BOUNDS[0], STATE_CLIP_BOUNDS[1])
        self.state[3] = np.clip(self.state[3], PSI_CLIP_BOUNDS[0], PSI_CLIP_BOUNDS[1])
        self.state[4] = np.clip(self.state[4], STATE_CLIP_BOUNDS[0], STATE_CLIP_BOUNDS[1])
        self.state[5] = np.clip(self.state[5], STATE_CLIP_BOUNDS[0], STATE_CLIP_BOUNDS[1])
        if stochastic:
            nφ, np_, nθ = self._noise_increment(dt, self.state[0])
            self.state[0] += nφ
            self.state[2] += np_
            self.state[5] += nθ
        self.time += dt
        self.energy_history.append(self.energy())
        tau = self._compute_wind_tau()
        self._wind_history.append(tau)

    def _compute_wind_tau(self) -> float:
        φ = self.state[0]
        p = self.state[2]
        par = self.p
        noise = par.wind_noise * self.rng.normal() if par.wind_noise > 0 else 0.0
        return par.tau_amp * φ + par.tau_coupling * p + noise

    def get_wind_series(self) -> np.ndarray:
        return np.array(self._wind_history)

    def integrate(self, n_steps: int = 2000, dt: float = 0.1,
                  stochastic: bool = True, init: Optional[np.ndarray] = None) -> np.ndarray:
        if init is not None:
            self.set_state(init)
        else:
            self.set_state(np.array([0.5, -3.0, 0.0, 0.0, 0.0, 0.0]))
        traj = np.zeros((n_steps+1, 6))
        traj[0] = self.state.copy()
        self.energy_history = [self.energy()]
        self._wind_history = []
        for i in range(n_steps):
            self.step_rk4(dt, stochastic=stochastic)
            traj[i+1] = self.state.copy()
        return traj

    def energy(self) -> float:
        φ, z, p = self.state[:3]
        return 0.5 * (φ**2 + z**2 + p**2)

    def get_g(self) -> float:
        return self._g(self.state[3])

    def set_state(self, state: np.ndarray) -> None:
        self.state = np.asarray(state, dtype=float).copy()
        self.state[3] = np.clip(self.state[3], PSI_CLIP_BOUNDS[0], PSI_CLIP_BOUNDS[1])

    def reset(self, seed: Optional[int] = None) -> None:
        if seed is not None:
            self.rng = default_rng(seed)
        self.state[:] = 0.0
        self.time = 0.0
        self.energy_history.clear()
        self._wind_history.clear()

