    max_iterations: int = 10
) -> Tuple[Optional[Tuple[float, float]], Optional[Tuple[float, float]]]:
    iteration = 0
    while (max(current_sigma_range) - min(current_sigma_range) > precision_threshold or
           max(current_lam_range) - min(current_lam_range) > precision_threshold) and \
          iteration < max_iterations:
        print(f"Iteration {iteration + 1}: Refining Sigma [{min(current_sigma_range):.4f}, {max(current_sigma_range):.4f}], "
              f"Lambda [{min(current_lam_range):.4f}, {max(current_lam_range):.4f}]")
        cv_matrix = np.zeros((len(current_sigma_range), len(current_lam_range)))
        switches_matrix = np.zeros((len(current_sigma_range), len(current_lam_range)))
        valid_pairs_in_grid = []
        for i, c_sig in enumerate(current_sigma_range):
            for j, c_lam in enumerate(current_lam_range):
                p_current = replace(initial_params, sigma=c_sig, lam=c_lam, A_force=0.0)
                model_current = OmegaBoxModel(params=p_current, seed=42)
                traj_current = model_current.integrate(n_steps=n_steps, dt=dt, stochastic=True)
                phi_current = traj_current[transient_steps:, 0]
                metrics = coherence_metrics(phi_current, dt=dt, threshold=threshold)
                if not np.isnan(metrics["cv_rt"]) and metrics["n_switches"] > 0:
                    valid_pairs_in_grid.append((c_sig, c_lam))
        if not valid_pairs_in_grid:
            print("  No bistable points found. Terminating.")
            return None, None
        avg_sigma = np.mean([p[0] for p in valid_pairs_in_grid])
        avg_lam = np.mean([p[1] for p in valid_pairs_in_grid])
        sigma_width = (max(current_sigma_range) - min(current_sigma_range)) / 2.0
        lam_width = (max(current_lam_range) - min(current_lam_range)) / 2.0
        new_sigma_min = max(0.0, avg_sigma - sigma_width / 2.0)
        new_sigma_max = avg_sigma + sigma_width / 2.0
        new_lam_min = max(0.0, avg_lam - lam_width / 2.0)
        new_lam_max = avg_lam + lam_width / 2.0
        current_sigma_range = np.linspace(new_sigma_min, new_sigma_max, len(current_sigma_range))
        current_lam_range = np.linspace(new_lam_min, new_lam_max, len(current_lam_range))
        iteration += 1

    print(f"Refinement complete after {iteration} iterations.")
    if valid_pairs_in_grid:
        final_sigma_entry = min(valid_pairs_in_grid, key=lambda x: x[0])
        final_lam_entry = min(valid_pairs_in_grid, key=lambda x: x[1])
        return final_sigma_entry, final_lam_entry
    return None, None

def identify_and_characterize_bistable_zones(
    sigma_range: np.ndarray,
    lam_range: np.ndarray,
    base_params: OmegaParameters,
    n_steps_sim: int,
    dt_sim: float,
    transient_sim: int,
    seed_sim: int,
    threshold_sim: float
) -> List[BistableZone]:
    print("\n--- Identifying and Characterizing Bistable Zones ---")
    cv_matrix = np.zeros((len(sigma_range), len(lam_range)))
    switches_matrix = np.zeros((len(sigma_range), len(lam_range)))
    for i, sig in enumerate(sigma_range):
        for j, lam in enumerate(lam_range):
            p = replace(base_params, sigma=sig, lam=lam, A_force=0.0)
            model = OmegaBoxModel(params=p, seed=seed_sim)
            traj = model.integrate(n_steps=n_steps_sim, dt=dt_sim, stochastic=True)
            phi = traj[transient_sim:, 0]
            met = coherence_metrics(phi, dt_sim, threshold=threshold_sim)
            cv_matrix[i, j] = met["cv_rt"]
            switches_matrix[i, j] = met["n_switches"]
    # Identify bistable points
    bistable_indices = np.where(~np.isnan(cv_matrix) & (switches_matrix > 0))
    if bistable_indices[0].size == 0:
        return []
    # Treat all as one zone (could be refined later)
    zone = BistableZone(
        id=1,
        sigma_min=float(np.min(sigma_range[bistable_indices[0]])),
        sigma_max=float(np.max(sigma_range[bistable_indices[0]])),
        lam_min=float(np.min(lam_range[bistable_indices[1]])),
        lam_max=float(np.max(lam_range[bistable_indices[1]])),
        avg_cv_rt=float(np.mean(cv_matrix[bistable_indices])),
        avg_switches=float(np.mean(switches_matrix[bistable_indices])),
        num_points=int(bistable_indices[0].size)
    )
    return [zone]

