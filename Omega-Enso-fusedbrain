def apply_rg_scaling(params: OmegaParameters, ln_l_final: float, num_rg_steps: int = 100) -> OmegaParameters:
    new_params = params.copy()
    d_ln_l_step = ln_l_final / num_rg_steps
    for _ in range(num_rg_steps):
        current_sigma = max(new_params.sigma, 1e-6)
        current_gamma = new_params.gamma
        current_lam = new_params.lam
        g_rg_coeff = 0.1
        Tr_Hgg = new_params.kappa
        Tr_HPP = new_params.lam
        Tr_L12L12 = new_params.alpha2
        eta_val = new_params.eta_std
        beta_sigma = - (current_sigma**2) / (16 * np.pi**2) + g_rg_coeff * (Tr_Hgg + current_gamma * Tr_HPP)
        beta_gamma = (current_gamma**2 * current_sigma) / (8 * np.pi**2) * Tr_L12L12 - eta_val * current_gamma
        beta_lam = -current_lam * Tr_L12L12 * 0.1
        new_params.sigma = max(new_params.sigma + beta_sigma * d_ln_l_step, 1e-6)
        new_params.gamma += beta_gamma * d_ln_l_step
        new_params.lam += beta_lam * d_ln_l_step
        new_params.gamma = max(new_params.gamma, 1e-6)
        new_params.lam = max(new_params.lam, 1e-6)
    return new_params

