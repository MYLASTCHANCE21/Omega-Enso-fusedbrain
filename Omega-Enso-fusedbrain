def validate_invariance(n_steps: int = 500, dt: float = 0.1) -> bool:
    print("\n--- Running Mathematical Invariance Validator ---")
    p = OmegaParameters(beta=0.0, alpha1=0.0, sigma=0.0, eps=0.0,
                        kappa=0.0, nu=0.0, beta_g=0.0, gamma=0.0,
                        chi=0.0, gamma_J=0.0, mu_J=0.0)
    omega_model = OmegaBoxModel(params=p, seed=42)
    init_box = np.array([0.5, -3.0, 0.0, 0.0, 0.0, 0.0])
    traj_omega = omega_model.integrate(n_steps=n_steps, dt=dt, stochastic=False, init=init_box)
    jin_model = JinOscillator(params=p, seed=42)
    init_jin = np.array([0.5, -3.0])
    traj_jin = jin_model.integrate(n_steps=n_steps, dt=dt, stochastic=False, init=init_jin)
    diff_phi = np.max(np.abs(traj_omega[:, 0] - traj_jin[:, 0]))
    diff_z = np.max(np.abs(traj_omega[:, 1] - traj_jin[:, 1]))
    max_diff = max(diff_phi, diff_z)
    print(f"Max discrepancy: {max_diff:.2e}")
    passed = max_diff < 1e-11
    print("RESULT:", "PASSED" if passed else "FAILED")
    return passed

