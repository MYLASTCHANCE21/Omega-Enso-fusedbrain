def extract_enso_regional_metrics(target_date: Optional[datetime] = None) -> dict:
    """Streams data securely via exact public buckets to handle unsigned permissions."""
    if not HAS_S3_LIBS:
        return generate_synthetic_noaa_backup("boto3 or xarray missing.")

    aws_config = Config(signature_version=UNSIGNED, region_name="us-east-1", retries={'max_attempts': 1})
    s3 = boto3.client('s3', config=aws_config)
    metrics = {"sst_anomaly_variance": 1.0, "atmosphere_damping_scale": 1.0}
    live_ocean = live_atmos = False

    if target_date is None:
        target_date = datetime.now() - timedelta(days=4)
    year = target_date.strftime("%Y")
    month = target_date.strftime("%m")
    day = target_date.strftime("%d")

    # Ocean Stream: noaa-oisst-pds
    try:
        ocean_bucket = "noaa-oisst-pds"
        ocean_key = f"oisst/v2.1/AVHRR/{year}{month}/oisst-avhrr-v02r01.{year}{month}{day}.nc"
        ocean_response = s3.get_object(Bucket=ocean_bucket, Key=ocean_key)
        with xr.open_dataset(io.BytesIO(ocean_response['Body'].read())) as ds_ocean:
            nino34_sst = ds_ocean['sst'].sel(lat=slice(-5, 5), lon=slice(190, 240))
            metrics["sst_anomaly_variance"] = float(nino34_sst.var().values)
            live_ocean = True
            print(f" -> [OISST] Pulled data for {year}-{month}-{day}")
    except Exception:
        pass

    # Atmospheric Stream: noaa-cdr-atmospheric-pds
    try:
        atmos_bucket = "noaa-cdr-atmospheric-pds"
        atmos_key = f"olr/v01r02/daily/{year}/olr-daily_v01r02_19790101_{year}{month}{day}.nc"
        atmos_response = s3.get_object(Bucket=atmos_bucket, Key=atmos_key)
        with xr.open_dataset(io.BytesIO(atmos_response['Body'].read())) as ds_atmos:
            lat_start, lat_end = (-5, 5) if ds_atmos['lat'].values[0] < ds_atmos['lat'].values[-1] else (5, -5)
            if ds_atmos['lon'].max() <= 180.0:
                nino34_olr = ds_atmos['olr'].sel(lat=slice(lat_start, lat_end), lon=slice(-170, -120))
            else:
                nino34_olr = ds_atmos['olr'].sel(lat=slice(lat_start, lat_end), lon=slice(190, 240))
            metrics["atmosphere_damping_scale"] = float(nino34_olr.mean().values) / 240.0
            live_atmos = True
            print(f" -> [OLR] Pulled data for {year}-{month}-{day}")
    except Exception:
        pass

    if not (live_ocean and live_atmos):
        return generate_synthetic_noaa_backup("Direct keys missing or target limits unarchived.")
    return metrics

