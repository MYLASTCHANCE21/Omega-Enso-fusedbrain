@dataclass
class WindyPoint:
    lat: float
    lon: float
    wind_u: float
    wind_v: float
    sst_anomaly: float
    timestamp: str
    confidence: float

class WindyComExporter:
    GRID_LATS = np.linspace(-5, 5, 11)
    GRID_LONS = np.linspace(160, 260, 51)

    def __init__(self, trajectory: np.ndarray, wind_series: np.ndarray,
                 dt: float = 0.1, start_date: Optional[datetime] = None):
        self.traj = trajectory
        self.wind = wind_series
        self.dt = dt
        self.start_date = start_date or datetime.now()
        self.points: List[WindyPoint] = []
        self._build_wind_field()

    def _phi_to_wind_anomaly(self, phi: float, base_tau: float) -> Tuple[float, float]:
        u_anom = base_tau * 25.0 + phi * 3.5
        v_anom = -phi * 0.8 + np.random.normal(0, 0.3)
        return u_anom, v_anom

    def _build_wind_field(self):
        n_steps = min(len(self.traj), len(self.wind))
        for step in range(0, n_steps, 50):
            phi = self.traj[step, 0]
            tau = self.wind[step] if step < len(self.wind) else 0.0
            t_delta = timedelta(hours=step * self.dt * 6)
            timestamp = (self.start_date + t_delta).isoformat()
            for lat in self.GRID_LATS:
                for lon in self.GRID_LONS:
                    lat_factor = np.cos(np.radians(lat))**2
                    u, v = self._phi_to_wind_anomaly(phi, tau)
                    u *= lat_factor
                    v *= lat_factor * 0.5
                    conf = 1.0 - abs(lon - 200) / 120.0
                    conf = np.clip(conf, 0.3, 1.0)
                    self.points.append(WindyPoint(
                        lat=float(lat),
                        lon=float(lon),
                        wind_u=round(float(u), 3),
                        wind_v=round(float(v), 3),
                        sst_anomaly=round(float(phi), 3),
                        timestamp=timestamp,
                        confidence=round(float(conf), 2)
                    ))

    def export_geojson(self, filepath: str) -> str:
        features = []
        for pt in self.points:
            features.append({
                "type": "Feature",
                "geometry": {"type": "Point", "coordinates": [pt.lon, pt.lat]},
                "properties": {
                    "u": pt.wind_u, "v": pt.wind_v,
                    "sst_anomaly": pt.sst_anomaly,
                    "time": pt.timestamp,
                    "confidence": pt.confidence,
                    "name": f"Ω-ENSO φ={pt.sst_anomaly:+.2f}"
                }
            })
        geojson = {
            "type": "FeatureCollection",
            "metadata": {
                "title": "Ω-ENSO Wind Anomaly Prediction",
                "source": "Ω-Box Model v1.4",
                "generated": datetime.now().isoformat(),
                "description": "Equatorial Pacific wind anomalies from Ω-ENSO framework"
            },
            "features": features
        }
        os.makedirs(os.path.dirname(filepath) or '.', exist_ok=True)
        with open(filepath, 'w') as f:
            json.dump(geojson, f, indent=2)
        print(f"[Windy.com] GeoJSON exported: {filepath}")
        return filepath

    def export_kml(self, filepath: str) -> str:
        kml_header = '''<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Ω-ENSO Wind Field Prediction</name>
  <description>Equatorial Pacific wind anomalies from Ω-Box model</description>
  <Style id="elNino">
    <LineStyle><color>ff0000ff</color><width>2</width></LineStyle>
  </Style>
  <Style id="laNina">
    <LineStyle><color>ffff0000</color><width>2</width></LineStyle>
  </Style>
  <Style id="neutral">
    <LineStyle><color>ff00ff00</color><width>1</width></LineStyle>
  </Style>
</Document>
</kml>'''
        placemarks = []
        for pt in self.points:
            style = "elNino" if pt.sst_anomaly > 0.3 else ("laNina" if pt.sst_anomaly < -0.3 else "neutral")
            scale = 0.5
            end_lon = pt.lon + pt.wind_u * scale
            end_lat = pt.lat + pt.wind_v * scale
            placemarks.append(f'''  <Placemark>
    <name>φ={pt.sst_anomaly:+.2f} τ=({pt.wind_u:+.1f},{pt.wind_v:+.1f})</name>
    <styleUrl>#{style}</styleUrl>
    <TimeStamp><when>{pt.timestamp}</when></TimeStamp>
    <LineString>
      <coordinates>{pt.lon},{pt.lat},0 {end_lon},{end_lat},0</coordinates>
    </LineString>
  </Placemark>''')
        kml = kml_header + '\n'.join(placemarks) + '\n</Document>\n</kml>'
        os.makedirs(os.path.dirname(filepath) or '.', exist_ok=True)
        with open(filepath, 'w') as f:
            f.write(kml)
        print(f"[Windy.com] KML exported: {filepath}")
        return filepath

    def export_csv(self, filepath: str) -> str:
        lines = ["lat,lon,u,v,sst_anomaly,timestamp,confidence"]
        for pt in self.points:
            lines.append(f"{pt.lat},{pt.lon},{pt.wind_u},{pt.wind_v},{pt.sst_anomaly},{pt.timestamp},{pt.confidence}")
        os.makedirs(os.path.dirname(filepath) or '.', exist_ok=True)
        with open(filepath, 'w') as f:
            f.write('\n'.join(lines))
        print(f"[Windy.com] CSV exported: {filepath}")
        return filepath

