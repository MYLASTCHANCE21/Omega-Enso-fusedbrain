    verify_metrics = coherence_metrics(filtered_phi, dt_verify, threshold=BISTABILITY_THRESHOLD)
    thermo = compute_framework_thermodynamics(verify_traj[transient_verify:], optimal_params, dt_verify)
    print(f"\nFiltered Verification Results:")
    print(f"  Mean Residence Time (RT): {verify_metrics['mean_rt']:.4f}")
    print(f"  CV of RT:                  {verify_metrics['cv_rt']:.4f} (Values < 1.0 confirm periodic clock)")
