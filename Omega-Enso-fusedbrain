def compute_lyapunov_exponent_with_history(model_params: OmegaParameters,
                                           initial_state: np.ndarray,
                                           dt: float, num_steps: int,
                                           perturbation: float = 1e-6,
                                           normalization_interval: int = 100) -> Tuple[float, List[float], List[float]]:
    print(f"\n--- Estimating Largest Lyapunov Exponent with History ---")
    model_ref = OmegaBoxModel(params=model_params.copy(), seed=42)
    model_ref.set_state(initial_state.copy())
    initial_state_perturbed = initial_state.copy()
    initial_state_perturbed[0] += perturbation
    model_pert = OmegaBoxModel(params=model_params.copy(), seed=42)
    model_pert.set_state(initial_state_perturbed.copy())

    sum_log_divergence = 0.0
    num_normalizations = 0
    log_divergence_history = []
    cumulative_le_history = []

    for i in range(1, num_steps + 1):
        model_ref.step_rk4(dt, stochastic=False)
        model_pert.step_rk4(dt, stochastic=False)
        if i % normalization_interval == 0:
            distance = np.linalg.norm(model_ref.state - model_pert.state)
            if distance == 0:
                print("Warning: Trajectories converged to zero distance.")
                break
            current_log_divergence = np.log(distance / perturbation)
            sum_log_divergence += current_log_divergence
            num_normalizations += 1
            log_divergence_history.append(current_log_divergence)
            cumulative_le_history.append(sum_log_divergence / (num_normalizations * normalization_interval * dt))
            if distance > 0:
                direction = (model_pert.state - model_ref.state) / distance
                model_pert.state = model_ref.state + direction * perturbation
            else:
                model_pert.state = model_ref.state + default_rng(seed=i).normal(size=initial_state.shape) * perturbation

    if num_normalizations == 0:
        return np.nan, [], []
    lyapunov_exponent = sum_log_divergence / (num_normalizations * normalization_interval * dt)
    return lyapunov_exponent, log_divergence_history, cumulative_le_history

def compute_lyapunov_exponent(model_params: OmegaParameters,
                              initial_state: np.ndarray,
                              dt: float, num_steps: int,
                              perturbation: float = 1e-6,
                              normalization_interval: int = 100) -> float:
    le, _, _ = compute_lyapunov_exponent_with_history(model_params, initial_state,
                                                      dt, num_steps, perturbation,
                                                      normalization_interval)
    return le

def sweep_lyapunov_exponent_with_force(base_params: OmegaParameters,
                                       initial_state: np.ndarray,
                                       dt: float, num_steps: int,
                                       perturbation: float,
                                       normalization_interval: int,
                                       a_force_range: np.ndarray) -> Tuple[List[float], List[float]]:
    print(f"\n--- Sweeping Lyapunov Exponent with A_force ---\n")
    estimated_les = []
    for a_force_val in a_force_range:
        print(f"  Calculating LE for A_force = {a_force_val:.4f}...")
        current_le_params = base_params.copy()
        current_le_params.A_force = a_force_val
        le, _, _ = compute_lyapunov_exponent_with_history(
            model_params=current_le_params,
            initial_state=initial_state,
            dt=dt,
            num_steps=num_steps,
            perturbation=perturbation,
            normalization_interval=normalization_interval
        )
        estimated_les.append(le)
    return list(a_force_range), estimated_les

