        p = deepcopy(base)
        p.sigma = float(np.clip(self.sigma, 0.3, 2.0))
        p.lam = float(np.clip(self.lam, 0.1, 1.5))
        p.tau_amp = float(np.clip(self.tau_amp, 0.0, 0.8))
        p.tau_coupling = float(np.clip(self.tau_coupling, 0.0, 1.0))
        return p

    @staticmethod
    def from_params(p: OmegaParameters) -> "Individual":
        return Individual(sigma=p.sigma, lam=p.lam,
                          tau_amp=p.tau_amp, tau_coupling=p.tau_coupling)

class MetaLearner:
    META_KEYS = ['sigma', 'lam', 'tau_amp', 'tau_coupling']

    def __init__(self, config: Optional[MetaConfig] = None,
                 base_params: Optional[OmegaParameters] = None):
        self.cfg = config or MetaConfig()
        self.base_params = base_params or OmegaParameters()
        self.rng = np.random.default_rng(self.cfg.seed)
        self.population: List[Individual] = []
        self.history: List[Dict] = []
        self.best_ever: Optional[Individual] = None

    def _random_individual(self) -> Individual:
        return Individual(
            sigma=self.rng.uniform(0.5, 1.3),
            lam=self.rng.uniform(0.2, 0.9),
            tau_amp=self.rng.uniform(0.05, 0.35),
            tau_coupling=self.rng.uniform(0.10, 0.55)
        )

    def evaluate(self, ind: Individual, seed: int) -> float:
        params = ind.to_params(self.base_params)
        model = OmegaBoxModel(params=params, seed=seed)
        init = np.array([
            self.rng.normal(0, 0.6),
            self.rng.normal(-1.5, 1.2),
            self.rng.normal(0, 0.3),
            0.0, 0.0, 0.0
        ])
        traj = model.integrate(n_steps=self.cfg.episode_steps, dt=self.cfg.dt,
                               stochastic=True, init=init)
        phi = traj[:, 0]
        met = coherence_metrics(phi, self.cfg.dt, threshold=0.4)
        cv = met['cv_rt'] if not np.isnan(met['cv_rt']) else 10.0
        n_sw = met['n_switches']
        snr = snr_proxy(phi, self.cfg.dt)
        phi_var = np.var(phi)

        exploration = 3.0 * np.exp(-phi_var * 3.0)
        switch_loss = abs(n_sw - self.cfg.target_switches) / max(self.cfg.target_switches, 1)
        cv_loss = abs(cv - self.cfg.target_cv)
        snr_loss = 10.0 / (snr + 1.0)
        loss = cv_loss + snr_loss + switch_loss + exploration

        ind.loss = float(loss)
        ind.cv = float(cv)
        ind.snr = float(snr)
        ind.n_switches = int(n_sw)
        ind.phi_var = float(phi_var)
        return loss

    def train(self) -> OmegaParameters:
        print("=" * 70)
        print("Ω-FRAMEWORK META-LEARNING — EVOLUTIONARY SEARCH")
        print("=" * 70)
        print(f"Population: {self.cfg.pop_size}, Generations: {self.cfg.n_generations}")
        print(f"Episode steps: {self.cfg.episode_steps}, Params: {self.META_KEYS}")
        print("-" * 70)

        self.population = [self._random_individual() for _ in range(self.cfg.pop_size)]

        for gen in range(self.cfg.n_generations):
            for i, ind in enumerate(self.population):
                seed = self.cfg.seed + gen * self.cfg.pop_size + i
                self.evaluate(ind, seed)

            self.population.sort(key=lambda x: x.loss)
            best = self.population[0]

            if self.best_ever is None or best.loss < self.best_ever.loss:
                self.best_ever = deepcopy(best)

            self.history.append({
                'gen': gen,
                'best_loss': best.loss,
                'mean_loss': np.mean([p.loss for p in self.population]),
                'best_cv': best.cv,
                'best_snr': best.snr,
                'best_switches': best.n_switches,
                'best_params': {k: getattr(best, k) for k in self.META_KEYS}
            })

            mut_scale = self.cfg.initial_sigma_mut * (
                self.cfg.final_sigma_mut / self.cfg.initial_sigma_mut
            ) ** (gen / max(self.cfg.n_generations - 1, 1))

            if gen % 2 == 0 or gen == self.cfg.n_generations - 1:
                print(f"Gen {gen:2d} | best_loss={best.loss:.3f} | "
                      f"CV={best.cv:.2f} SNR={best.snr:.1f} Sw={best.n_switches:2d} | "
                      f"σ={best.sigma:.3f} λ={best.lam:.3f} τa={best.tau_amp:.3f} τc={best.tau_coupling:.3f} | "
                      f"mut={mut_scale:.3f}")

            if gen == self.cfg.n_generations - 1:
                break

            n_elite = max(1, int(self.cfg.elite_frac * self.cfg.pop_size))
            new_pop = [deepcopy(self.population[i]) for i in range(n_elite)]

            while len(new_pop) < self.cfg.pop_size:
                parent = self.population[self.rng.integers(0, n_elite)]
                child = Individual(
                    sigma=parent.sigma + self.rng.normal(0, mut_scale),
                    lam=parent.lam + self.rng.normal(0, mut_scale),
                    tau_amp=parent.tau_amp + self.rng.normal(0, mut_scale * 0.5),
                    tau_coupling=parent.tau_coupling + self.rng.normal(0, mut_scale)
                )
                new_pop.append(child)

            self.population = new_pop

        print("-" * 70)
        print(f"EVOLUTION COMPLETE. Best loss: {self.best_ever.loss:.4f}")
        print("Best parameters found:")
        for k in self.META_KEYS:
            print(f"  {k:15s} = {getattr(self.best_ever, k):.6f}")
        print("=" * 70)
        return self.best_ever.to_params(self.base_params)

    def adapt_online(self, obs_phi: float, obs_tau: float,
                     current: OmegaParameters) -> OmegaParameters:
        base_ind = Individual.from_params(current)
        best_err = float('inf')
        best_ind = base_ind

        for _ in range(12):
            candidate = Individual(
                sigma=base_ind.sigma + self.rng.normal(0, 0.08),
                lam=base_ind.lam + self.rng.normal(0, 0.08),
                tau_amp=base_ind.tau_amp + self.rng.normal(0, 0.05),
                tau_coupling=base_ind.tau_coupling + self.rng.normal(0, 0.08)
            )
            p = candidate.to_params(self.base_params)
            model = OmegaBoxModel(params=p, seed=42)
            model.set_state(np.array([obs_phi, -1.5, 0.0, 0.0, 0.0, 0.0]))
            traj = model.integrate(n_steps=300, dt=0.1, stochastic=True)
            phi_pred = traj[-1, 0]
            wind = model.get_wind_series()
            tau_pred = wind[-1] if len(wind) > 0 else 0.0
            err = (phi_pred - obs_phi)**2 + (tau_pred - obs_tau)**2
            if err < best_err:
                best_err = err
                best_ind = candidate

        return best_ind.to_params(self.base_params)

    def save_checkpoint(self, filepath: str):
        os.makedirs(os.path.dirname(filepath) or '.', exist_ok=True)
        data = {
            'history': self.history,
            'best': {k: getattr(self.best_ever, k) for k in self.META_KEYS + ['loss', 'cv', 'snr', 'n_switches']},
            'timestamp': datetime.now().isoformat()
        }
        with open(filepath, 'w') as f:
            json.dump(data, f, indent=2)
        print(f"[Meta-Learning] Checkpoint saved: {filepath}")

