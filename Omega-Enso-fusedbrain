    for i, sig in enumerate(sigma_range):
        for j, lam in enumerate(lam_range):
            if not np.isnan(cv_matrix[i, j]) and switches_matrix[i, j] > 0:
                valid_pairs.append((sig, lam))
    if valid_pairs:
        precise_sigma_entry = min(valid_pairs, key=lambda x: x[0])
