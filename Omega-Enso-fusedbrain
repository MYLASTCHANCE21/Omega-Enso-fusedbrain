    verify_model = OmegaBoxModel(params=optimal_params, seed=42)
    verify_traj = verify_model.integrate(n_steps=n_steps_verify, dt=dt_verify, stochastic=True)
    raw_phi = verify_traj[transient_verify:, 0]
