def compute_alpha_T_eff(alpha0: float, kappa: float, nu: float, psi: float, J: float) -> float:
    g = np.exp(np.clip(psi, -20.0, 20.0))
    return alpha0 + kappa * (g + 1.0 / g) + nu * J

def compute_critical_sigma(lambda_val: float, alpha_T_eff: float,
                           alpha1: float, alpha2: float, c: float, d: float) -> float:
    denom = alpha1 * (alpha_T_eff + lambda_val)
    if denom <= 1e-12:
        return np.nan
    t1 = alpha_T_eff * d + alpha_T_eff * lambda_val + d * lambda_val + alpha2 * c
    t2 = alpha_T_eff + d + lambda_val
    t3 = lambda_val * (alpha_T_eff * d + alpha2 * c)
    return float((t1 * t2 - t3) / denom)

def compute_critical_lambda(sigma_val: float, alpha_T_eff: float,
                            alpha1: float, alpha2: float, c: float, d: float,
                            lam_search: Tuple[float, float] = (0.01, 2.0),
                            n_grid: int = 4000) -> float:
    lam_grid = np.linspace(lam_search[0], lam_search[1], n_grid)
    sig_grid = np.array([compute_critical_sigma(l, alpha_T_eff, alpha1, alpha2, c, d)
                         for l in lam_grid])
    valid = ~np.isnan(sig_grid)
    if not np.any(valid):
        return np.nan
    lam_v, sig_v = lam_grid[valid], sig_grid[valid]
    diff = sig_v - sigma_val
    if np.all(diff > 0):
        return float(lam_v[-1])
    if np.all(diff < 0):
        return float(lam_v[0])
    idx = np.where(np.diff(np.sign(diff)))[0]
    if len(idx) == 0:
        return float(lam_v[np.argmin(np.abs(diff))])
    i = idx[0]
    frac = (sigma_val - sig_v[i]) / (sig_v[i+1] - sig_v[i] + 1e-12)
    return float(lam_v[i] + frac * (lam_v[i+1] - lam_v[i]))

def bifurcation_distance(state: np.ndarray, params: OmegaParameters) -> Dict[str, float]:
    phi, z, p, psi, J, theta = state
    alpha_T_eff = compute_alpha_T_eff(params.alpha0, params.kappa, params.nu, psi, J)
    sigma_crit = compute_critical_sigma(params.lam, alpha_T_eff,
                                        params.alpha1, params.alpha2, params.c, params.d)
    lambda_crit = compute_critical_lambda(params.sigma, alpha_T_eff,
                                          params.alpha1, params.alpha2, params.c, params.d)
    d_sigma = params.sigma - sigma_crit
    d_lambda = params.lam - lambda_crit
    return {
        "alpha_T_eff": float(alpha_T_eff),
        "sigma_crit": float(sigma_crit),
        "lambda_crit": float(lambda_crit),
        "d_sigma": float(d_sigma),
        "d_lambda": float(d_lambda),
        "frac_sigma": float(d_sigma / max(abs(sigma_crit), 1e-6)),
        "frac_lambda": float(d_lambda / max(abs(lambda_crit), 1e-6)),
        "is_unstable_linear": bool(d_sigma > 0 and d_lambda > 0),
    }

